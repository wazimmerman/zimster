{
  "name": "zimster",
  "version": "0.4.0",
  "description": "A proof-first, owner-driven development workflow for capable coding agents.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec",
    "validate": "node scripts/validate.mjs",
    "validate:claude": "node scripts/validate-claude-plugin.mjs",
    "validate:adapters": "node scripts/validate-adapters.mjs",
    "validate:codex": "node scripts/validate-codex.mjs",
    "doctor": "node scripts/doctor.mjs",
    "commands": "node scripts/project-commands.mjs",
    "snapshot": "node scripts/change-snapshot.mjs",
    "review:integrity": "node scripts/review-integrity.mjs",
    "evidence": "node scripts/evidence.mjs",
    "dispatch": "node scripts/dispatch-record.mjs",
    "run:init": "node scripts/init-run.mjs",
    "sync:codex": "node scripts/sync-codex-plugin.mjs",
    "sync:codex:check": "node scripts/sync-codex-plugin.mjs --check",
    "sync-skills": "node scripts/sync-skills.mjs",
    "codex:cachebuster": "node scripts/codex-cachebuster.mjs",
    "version:check": "node scripts/check-version.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "package": "node scripts/package.mjs",
    "checksums": "node scripts/checksums.mjs",
    "capability:status": "node scripts/capability-cache.mjs status",
    "postmortem": "node scripts/run-postmortem.mjs",
    "evaluate:economy": "node scripts/evaluate-execution-economy.mjs",
    "goal:verify": "node scripts/verify.mjs run --profile goal",
    "release:verify": "node scripts/verify.mjs run --profile release",
    "check": "npm run test && npm run validate && npm run package"
  },
  "main": ".opencode/plugins/zimster.js",
  "keywords": [
    "skills",
    "tdd",
    "debugging",
    "code-review",
    "workflow",
    "agentic-development",
    "token-efficiency"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wazimmerman/zimster.git"
  },
  "homepage": "https://github.com/wazimmerman/zimster",
  "bugs": {
    "url": "https://github.com/wazimmerman/zimster/issues"
  },
  "files": [
    ".agents",
    ".claude-plugin",
    ".codex-plugin",
    ".cursor",
    ".kimi-plugin",
    ".opencode",
    ".pi",
    "assets",
    "docs",
    "hooks",
    "scripts",
    "skills",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "agents",
    "templates",
    "PRIVACY.md",
    "TERMS.md",
    "SUPPORT.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "plugins",
    "config",
    "schemas",
    "vendor"
  ],
  "pi": {
    "extensions": [
      "./.pi/extensions/zimster.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
