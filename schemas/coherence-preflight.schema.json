{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zimster.dev/schemas/coherence-preflight.schema.json",
  "title": "Zimster final coherence preflight",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "operation",
    "profile",
    "candidate",
    "issues",
    "components"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "enum": ["COHERENCE_CURRENT", "COHERENCE_BLOCKED"] },
    "operation": { "enum": ["review", "completion", "release"] },
    "profile": { "enum": ["micro", "standard", "high-risk"] },
    "candidate": {
      "type": "object",
      "required": ["head", "tree", "dirty_tree_fingerprint"],
      "properties": {
        "head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "dirty_tree_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "issues": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "components": {
      "type": "object",
      "required": [
        "run_revision",
        "checkpoint_revision",
        "accounting_status",
        "lifecycle_status"
      ],
      "properties": {
        "run_revision": { "type": ["integer", "null"], "minimum": 0 },
        "checkpoint_revision": { "type": ["integer", "null"], "minimum": 0 },
        "accounting_status": { "type": "string", "minLength": 1 },
        "lifecycle_status": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "COHERENCE_CURRENT" } } },
      "then": { "properties": { "issues": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "status": { "const": "COHERENCE_BLOCKED" } } },
      "then": { "properties": { "issues": { "minItems": 1 } } }
    }
  ],
  "additionalProperties": false
}
