{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zimster.dev/schemas/release-evidence.schema.json",
  "type": "object",
  "required": ["schema_version", "version", "tag", "channel", "commit", "tree", "standards_lock_sha256", "semantic_review_sha256", "host_matrix_sha256", "verification_sha256", "embedded_inputs", "artifacts"],
  "properties": {
    "schema_version": { "const": 2 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "channel": { "enum": ["public_beta", "stable"] },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "standards_lock_sha256": { "$ref": "#/$defs/sha256" },
    "semantic_review_sha256": { "$ref": "#/$defs/sha256" },
    "host_matrix_sha256": { "$ref": "#/$defs/sha256" },
    "verification_sha256": { "$ref": "#/$defs/sha256" },
    "embedded_inputs": {
      "type": "object",
      "required": ["semantic-review.json", "host-matrix.json", "verification.json"],
      "properties": {
        "semantic-review.json": { "$ref": "#/$defs/canonicalBase64" },
        "host-matrix.json": { "$ref": "#/$defs/canonicalBase64" },
        "verification.json": { "$ref": "#/$defs/canonicalBase64" }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "required": ["name", "sha256", "size"],
        "properties": {
          "name": { "type": "string", "pattern": "^zimster-" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "size": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "canonicalBase64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 1398104,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    }
  },
  "additionalProperties": false
}
