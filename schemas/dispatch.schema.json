{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wazimmerman/zimster/schemas/dispatch.schema.json",
  "title": "Zimster subagent dispatch record",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema_version", "id", "role", "purpose", "tier", "requested_model", "requested_effort", "effective_model", "effective_effort", "turn_limit", "created_at"],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "tier": { "enum": ["fast", "standard", "expert"] },
        "requested_model": { "type": "string", "minLength": 1 },
        "requested_effort": { "type": "string", "minLength": 1 },
        "effective_model": { "type": "string", "minLength": 1 },
        "effective_effort": { "type": "string", "minLength": 1 },
        "turn_limit": { "type": "integer", "minimum": 1 },
        "created_at": { "type": "string" }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["schema_version", "id", "run_id", "delegation_id", "proposal_id", "resolution_id", "role", "purpose", "capability_class", "requested_model", "requested_provider", "requested_effort", "effective_model", "effective_effort", "availability", "enforcement", "effective_reporting", "resolution_mode", "mapping_source", "mapping_digest", "fallback_trace", "turn_limit", "owner_acceptance", "created_at"],
      "properties": {
        "schema_version": { "const": 2 },
        "id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "delegation_id": { "type": "string", "minLength": 1 },
        "proposal_id": { "type": "string", "minLength": 1 },
        "resolution_id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "capability_class": { "enum": ["economy", "balanced", "expert", "inherit"] },
        "requested_model": { "type": "string", "minLength": 1 },
        "requested_provider": { "type": ["string", "null"] },
        "requested_effort": { "type": "string", "minLength": 1 },
        "effective_model": { "type": "string", "minLength": 1 },
        "effective_effort": { "type": "string", "minLength": 1 },
        "availability": { "type": "string", "minLength": 1 },
        "enforcement": { "type": "string", "minLength": 1 },
        "effective_reporting": { "type": "string", "minLength": 1 },
        "resolution_mode": { "enum": ["recommend", "map_only", "auto_within_policy", "inherit"] },
        "mapping_source": { "type": "string", "minLength": 1 },
        "mapping_digest": { "type": "string", "minLength": 1 },
        "fallback_trace": { "type": "array", "items": { "type": "string" } },
        "turn_limit": { "type": "integer", "minimum": 1 },
        "owner_acceptance": {
          "type": "object",
          "required": ["status", "proof", "accepted_at"],
          "properties": {
            "status": { "enum": ["pending", "accepted", "rejected"] },
            "proof": { "type": ["string", "null"] },
            "accepted_at": { "type": ["string", "null"] },
            "decided_at": { "type": "string" }
          },
          "additionalProperties": false
        },
        "created_at": { "type": "string" }
      },
      "additionalProperties": true
    }
  ]
}
