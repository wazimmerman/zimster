{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wazimmerman/zimster/schemas/model-proposal.schema.json",
  "title": "Zimster model proposal",
  "type": "object",
  "required": ["schema_version", "id", "delegation_id", "run_id", "session_id", "phase", "authority", "capability_class", "reasoning_effort", "task_signature", "mode", "policy", "concrete_model", "availability", "git_fingerprint", "config_digest", "mapping_digest", "harness", "harness_version", "capability_digest", "catalog_digest", "explicit_override_digest", "input_fingerprint", "supersedes", "superseded_by", "status", "created_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "delegation_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": ["string", "null"] },
    "phase": { "enum": ["plan", "dispatch"] },
    "authority": { "enum": ["advisory", "authoritative"] },
    "capability_class": { "enum": ["economy", "balanced", "expert", "inherit"] },
    "reasoning_effort": { "type": "string", "minLength": 1 },
    "task_signature": { "type": "object" },
    "mode": { "enum": ["recommend", "map_only", "auto_within_policy", "inherit"] },
    "policy": { "enum": ["quality_first", "balanced", "cost_optimized"] },
    "concrete_model": { "type": ["string", "null"] },
    "availability": { "enum": ["available", "unavailable", "stale", "unverified"] },
    "git_fingerprint": { "type": "string" },
    "config_digest": { "type": "string" },
    "mapping_digest": { "type": "string" },
    "harness": { "type": "string" },
    "harness_version": { "type": "string" },
    "capability_digest": { "type": "string" },
    "catalog_digest": { "type": "string" },
    "explicit_override_digest": { "type": "string" },
    "input_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "supersedes": { "type": ["string", "null"] },
    "superseded_by": { "type": ["string", "null"] },
    "status": { "enum": ["active", "consumed", "invalidated", "cancelled"] },
    "consumed_by": { "type": "string", "minLength": 1 },
    "consumed_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    { "if": { "properties": { "phase": { "const": "plan" } } }, "then": { "properties": { "authority": { "const": "advisory" } } } },
    { "if": { "properties": { "phase": { "const": "dispatch" } } }, "then": { "properties": { "authority": { "const": "authoritative" } } } }
  ],
  "additionalProperties": false
}
