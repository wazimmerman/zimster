{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wazimmerman/zimster/schemas/recovery-checkpoint.schema.json",
  "title": "Zimster compact in-progress recovery checkpoint",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "run_state_revision",
    "current_slice",
    "next_slice",
    "repository_state",
    "completed_obligations",
    "remaining_obligations",
    "latest_meaningful_verification",
    "active_failure",
    "corrections_completed",
    "open_findings",
    "evidence_receipts",
    "review_position",
    "budget_position",
    "unavailable_evidence",
    "guards",
    "exact_next_action",
    "exact_next_command",
    "recovery_status"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "run_id": {"type": "string", "minLength": 1},
    "run_state_revision": {"type": "integer", "minimum": 0},
    "current_slice": {"type": ["object", "null"]},
    "next_slice": {"type": ["object", "null"]},
    "slice_base": {"type": ["object", "null"]},
    "repository_state": {
      "type": "object",
      "required": ["head", "tree", "dirty_tree_fingerprint", "touched_files"],
      "properties": {
        "head": {"type": ["string", "null"]},
        "tree": {"type": ["string", "null"]},
        "dirty_tree_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "touched_files": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "completed_obligations": {"type": "array", "items": {"type": "string"}},
    "remaining_obligations": {"type": "array", "items": {"type": "string"}},
    "blocking_obligations": {"type": "array", "items": {"type": "string"}},
    "latest_meaningful_verification": {"type": ["object", "null"]},
    "active_failure": {"type": ["object", "null"]},
    "corrections_completed": {"type": "array", "items": {"type": "string"}},
    "open_findings": {"type": "array", "items": {"type": "string"}},
    "evidence_receipts": {"type": "array", "items": {"type": "object"}},
    "review_position": {"type": "object"},
    "budget_position": {"type": "object"},
    "unavailable_evidence": {"type": "array", "items": {"type": "string"}},
    "guards": {"type": "array", "items": {"type": "object"}},
    "exact_next_action": {"type": ["string", "null"]},
    "exact_next_command": {"type": ["string", "null"]},
    "environment": {"type": "object"},
    "recovery_status": {"type": "string", "minLength": 1},
    "reconciliation_reason": {"type": "string"},
    "active_transaction": {"$ref": "control-plane-transaction.schema.json"}
  },
  "additionalProperties": true
}
