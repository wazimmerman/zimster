{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zimster.dev/schemas/accounting-reconciliation.schema.json",
  "title": "Zimster Execution Accounting Reconciliation",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "observed",
    "corrections",
    "supporting_execution_ids",
    "unobserved_direct_shell_commands"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "status": {
      "enum": [
        "ACCOUNTING_CURRENT",
        "STALE_ACCOUNTING",
        "ACCOUNTING_RECONCILED",
        "ACCOUNTING_UNVERIFIED"
      ]
    },
    "reason": { "type": "string", "minLength": 1 },
    "observed": {
      "type": "object",
      "required": ["complete_suite_executions", "exact_duplicate_commands"],
      "properties": {
        "complete_suite_executions": { "type": "integer", "minimum": 0 },
        "exact_duplicate_commands": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "metric",
          "prior_value",
          "observed_value",
          "corrected_value",
          "supporting_execution_ids",
          "reason"
        ],
        "properties": {
          "metric": { "enum": ["complete_suite_executions", "exact_duplicate_commands"] },
          "prior_value": { "type": ["integer", "null"], "minimum": 0 },
          "observed_value": { "type": "integer", "minimum": 0 },
          "corrected_value": { "type": "integer", "minimum": 0 },
          "supporting_execution_ids": {
            "type": "array",
            "items": { "type": "string", "format": "uuid" }
          },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "supporting_execution_ids": {
      "type": "object",
      "required": ["complete_suite_executions", "exact_duplicate_commands"],
      "properties": {
        "complete_suite_executions": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" }
        },
        "exact_duplicate_commands": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" }
        }
      },
      "additionalProperties": false
    },
    "unobserved_direct_shell_commands": { "const": "not_observable" },
    "operation": { "type": ["string", "null"] }
  },
  "allOf": [{
    "if": {
      "properties": { "status": { "const": "ACCOUNTING_UNVERIFIED" } },
      "required": ["status"]
    },
    "then": { "required": ["reason"] }
  }],
  "additionalProperties": false
}
