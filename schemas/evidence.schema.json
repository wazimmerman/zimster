{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wazimmerman/zimster/schemas/evidence.schema.json",
  "title": "Zimster evidence receipt",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "kind",
    "scope",
    "command",
    "cwd",
    "git_head",
    "git_tree",
    "working_tree_hash",
    "started_at",
    "ended_at",
    "exit_code",
    "environment",
    "tests"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "path_identity_format": {
      "enum": [
        "canonical-v1"
      ],
      "description": "Canonical paths stored as repository-relative POSIX strings or file URLs."
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "command_argv": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "command_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "cwd": {
      "type": "string"
    },
    "git_head": {
      "type": [
        "string",
        "null"
      ]
    },
    "git_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "git_tree": {
      "type": [
        "string",
        "null"
      ]
    },
    "working_tree_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dirty_tree_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "started_at": {
      "type": "string"
    },
    "ended_at": {
      "type": "string"
    },
    "exit_code": {
      "type": "integer"
    },
    "harness": {
      "type": [
        "string",
        "null"
      ]
    },
    "capabilities": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "enum": [
          "native",
          "supported_with_constraints",
          "prompt_constrained",
          "inline_fallback",
          "unavailable",
          "unverified"
        ]
      }
    },
    "behavioral_evidence": {
      "type": "boolean"
    },
    "governed_execution": {
      "type": "boolean"
    },
    "evidence_class": {
      "enum": ["diagnostic", "claim_establishing"]
    },
    "tdd": {
      "type": ["object", "null"],
      "properties": {
        "phase": { "enum": ["red", "green"] },
        "pair_id": { "type": "string", "minLength": 1 }
      },
      "required": ["phase", "pair_id"],
      "additionalProperties": false
    },
    "invalidation_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "environment": {
      "type": "object"
    },
    "environment_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tests": {
      "type": "object",
      "required": [
        "discovery",
        "passed",
        "failed",
        "skipped"
      ],
      "properties": {
        "discovery": {
          "enum": [
            "not_reached",
            "zero_discovered",
            "tests_executed",
            "unknown"
          ]
        },
        "discovered": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "passed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "failed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "skipped": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "dependency_cone": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependency_fingerprints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "input",
          "digest"
        ],
        "properties": {
          "input": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_fingerprints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "input",
          "digest"
        ],
        "properties": {
          "input": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "requirement_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
      }
    },
    "establishes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "does_not_establish": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "environment_scope": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "command_argv",
          "command_identity",
          "git_commit",
          "dirty_tree_fingerprint",
          "environment_fingerprint",
          "governed_execution",
          "evidence_class",
          "dependency_fingerprints",
          "requirement_ids",
          "establishes",
          "does_not_establish",
          "environment_scope"
        ]
      }
    }
  ]
}
