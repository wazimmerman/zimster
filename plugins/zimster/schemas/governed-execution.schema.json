{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zimster.dev/schemas/governed-execution.schema.json",
  "title": "Zimster Governed Execution Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "issuer",
    "status",
    "started_at",
    "command_argv",
    "command_identity",
    "cwd",
    "complete_suite",
    "duplicate_ordinal",
    "candidate",
    "environment",
    "runtime_provenance",
    "governing_policy"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "format": "uuid" },
    "run_id": { "type": ["string", "null"] },
    "issuer": { "enum": ["zimster.verify", "zimster.evidence"] },
    "status": { "enum": ["running", "passed", "failed"] },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": ["string", "null"], "format": "date-time" },
    "command_argv": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "command_identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "cwd": { "type": "string" },
    "profile": { "type": ["string", "null"] },
    "context": { "type": ["object", "null"] },
    "complete_suite": { "type": "boolean" },
    "duplicate_ordinal": { "type": "integer", "minimum": 1 },
    "candidate": { "$ref": "#/$defs/candidate" },
    "environment": {
      "type": "object",
      "required": ["platform", "release", "arch", "node"],
      "properties": {
        "platform": { "type": "string" },
        "release": { "type": "string" },
        "arch": { "type": "string" },
        "node": { "type": "string" }
      },
      "additionalProperties": false
    },
    "runtime_provenance": { "$ref": "#/$defs/runtimeProvenance" },
    "governing_policy": { "$ref": "#/$defs/governingPolicy" },
    "terminal_receipt_type": { "enum": [null, "verification", "evidence"] },
    "terminal_receipt_id": { "type": ["string", "null"] },
    "terminal_receipt_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "exit_code": { "type": ["integer", "null"] },
    "compact_result": { "type": ["object", "null"] }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "required": ["head", "tree", "dirty_tree_fingerprint"],
      "properties": {
        "head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "dirty_tree_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "runtimeProvenance": {
      "type": "object",
      "required": [
        "semantic_version",
        "source_commit",
        "source_tree",
        "source_dirty_tree_fingerprint",
        "runtime_origin",
        "issuer"
      ],
      "properties": {
        "semantic_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "source_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "source_dirty_tree_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "runtime_origin": { "type": "string" },
        "issuer": { "type": "string" }
      },
      "additionalProperties": true
    },
    "governingPolicy": {
      "type": "object",
      "required": ["runtime_role", "candidate_rules_authoritative"],
      "properties": {
        "runtime_role": { "enum": ["governing_runtime", "candidate_under_test"] },
        "candidate_rules_authoritative": { "type": "boolean" },
        "accepted_policy": { "type": ["object", "string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
