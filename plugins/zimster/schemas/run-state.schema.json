{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wazimmerman/zimster/schemas/run-state.schema.json",
  "title": "Zimster canonical durable run state",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "root_actor_id",
    "started_at",
    "starting_head",
    "plan",
    "state_revision",
    "current_slice",
    "next_slice",
    "exact_next_action",
    "exact_next_command",
    "completed_slices",
    "guard_assertions"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "id": {"type": "string", "minLength": 1},
    "root_actor_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "starting_head": {"type": ["string", "null"]},
    "plan": {
      "type": "object",
      "required": ["id", "source"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "profile": {"type": ["string", "null"]},
    "profile_rationale": {"type": ["string", "null"]},
    "durable_state_triggers": {"type": "array", "items": {"type": "string"}},
    "branch": {"type": ["string", "null"]},
    "capability_receipt": {"type": ["object", "null"]},
    "state_revision": {"type": "integer", "minimum": 0},
    "current_slice": {"oneOf": [{"$ref": "#/$defs/currentSlice"}, {"type": "null"}]},
    "next_slice": {"oneOf": [{"$ref": "#/$defs/sliceIdentity"}, {"type": "null"}]},
    "exact_next_action": {"type": ["string", "null"]},
    "exact_next_command": {"type": ["string", "null"]},
    "completed_slices": {"type": "array", "items": {"type": "object"}},
    "guard_assertions": {"type": "array", "items": {"$ref": "#/$defs/guard"}},
    "architecture": {"type": "array", "items": {"type": "string"}},
    "migration": {"type": "object"}
  },
  "$defs": {
    "sliceIdentity": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "currentSlice": {
      "allOf": [
        {"$ref": "#/$defs/sliceIdentity"},
        {
          "type": "object",
          "required": [
            "status",
            "base_head",
            "base_tree",
            "completed_obligations",
            "remaining_obligations"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_started",
                "in_progress",
                "blocked",
                "awaiting_verification",
                "awaiting_review",
                "complete"
              ]
            },
            "base_head": {"type": ["string", "null"]},
            "base_tree": {"type": ["string", "null"]},
            "completed_obligations": {"type": "array", "items": {"type": "string"}},
            "remaining_obligations": {"type": "array", "items": {"type": "string"}}
          }
        }
      ]
    },
    "guard": {
      "type": "object",
      "required": ["id", "statement", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "source": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
