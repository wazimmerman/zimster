{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wazimmerman/zimster/schemas/review-lifecycle.schema.json",
  "title": "Zimster bounded review lifecycle",
  "type": "object",
  "required": [
    "schema_version",
    "seam_id",
    "reviewer_identity",
    "initial_candidate",
    "candidate",
    "status",
    "stable",
    "circuit_breaker_active",
    "correction_recheck_consumed",
    "review_policy",
    "strategy_escalation",
    "historical_excess_attempt_ids",
    "active_attempt_id",
    "attempts",
    "invalidated_attempt_ids",
    "reviewer_dispositions",
    "dispositions",
    "events"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "seam_id": {"type": "string", "minLength": 1},
    "reviewer_identity": {"type": "string", "minLength": 1},
    "initial_candidate": {"$ref": "#/$defs/candidate"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "status": {
      "enum": [
        "initial_review_required",
        "review_in_progress",
        "correction_required",
        "correction_recheck_required",
        "new_design_review_required",
        "approved",
        "final_review_in_progress",
        "final_correction_required",
        "final_approved",
        "circuit_breaker_active",
        "strategy_escalation_required",
        "blocked",
        "partial"
      ]
    },
    "stable": {"type": "boolean"},
    "circuit_breaker_active": {"type": "boolean"},
    "correction_recheck_consumed": {"type": "boolean"},
    "review_policy": {
      "type": "object",
      "required": [
        "primary_reviews_per_semantic_contract",
        "correction_rechecks",
        "final_integration_reviews"
      ],
      "properties": {
        "primary_reviews_per_semantic_contract": {"const": 1},
        "correction_rechecks": {"const": 1},
        "final_integration_reviews": {"const": 2}
      },
      "additionalProperties": false
    },
    "strategy_escalation": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": [
            "status",
            "trigger",
            "attempt_id",
            "observed_final_attempts",
            "hard_limit"
          ],
          "properties": {
            "status": {"enum": ["required", "resolved"]},
            "trigger": {
              "enum": [
                "final_review_attempts_exhausted",
                "historical_review_attempts_exceeded_hard_limit"
              ]
            },
            "attempt_id": {"type": "string", "minLength": 1},
            "observed_final_attempts": {"type": "integer", "minimum": 2},
            "hard_limit": {"const": 2},
            "disposition": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      ]
    },
    "historical_excess_attempt_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "active_attempt_id": {"type": ["string", "null"]},
    "attempts": {
      "type": "array",
      "items": {"$ref": "#/$defs/attempt"}
    },
    "invalidated_attempt_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "reviewer_dispositions": {
      "type": "array",
      "items": {"$ref": "#/$defs/reviewerDisposition"}
    },
    "dispositions": {"type": "array", "items": {"type": "object"}},
    "events": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "required": [
        "base_sha",
        "head_sha",
        "tree_sha",
        "dirty_tree_fingerprint",
        "semantic_contract_sha256"
      ],
      "properties": {
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty_tree_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "semantic_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "required": [
        "attempt_type",
        "attempt_id",
        "seam_id",
        "reviewer_identity",
        "review_package_id",
        "candidate",
        "verdict",
        "findings"
      ],
      "properties": {
        "attempt_type": {
          "enum": [
            "initial_review",
            "correction_recheck",
            "new_design_review",
            "final_integration_review"
          ]
        },
        "attempt_id": {"type": "string", "minLength": 1},
        "seam_id": {"type": "string", "minLength": 1},
        "reviewer_identity": {"type": "string", "minLength": 1},
        "review_package_id": {"type": "string", "minLength": 1},
        "candidate": {"$ref": "#/$defs/candidate"},
        "verdict": {"enum": [null, "approved", "needs_correction"]},
        "findings": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "reviewerDisposition": {
      "type": "object",
      "required": [
        "disposition_id",
        "attempt_id",
        "reviewer_identity",
        "review_package_id",
        "candidate",
        "conclusion",
        "dispatch_id",
        "routing_observation_id",
        "resolutions"
      ],
      "properties": {
        "disposition_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "attempt_id": {"type": "string", "minLength": 1},
        "reviewer_identity": {"type": "string", "minLength": 1},
        "review_package_id": {"type": "string", "minLength": 1},
        "candidate": {"$ref": "#/$defs/candidate"},
        "conclusion": {
          "enum": ["reviewer_rebutted_with_evidence", "non_load_bearing_deferral"]
        },
        "dispatch_id": {"type": "string", "minLength": 1},
        "routing_observation_id": {"type": "string", "minLength": 1},
        "resolutions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["finding_fingerprint", "outcome", "evidence_refs"],
            "properties": {
              "finding_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "outcome": {"enum": ["rebutted", "non_load_bearing"]},
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
