{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wazimmerman/zimster/schemas/routing-observation.schema.json",
  "title": "Zimster local routing observation",
  "type": "object",
  "required": ["schema_version", "id", "run_id", "dispatch_id", "harness", "harness_version_family", "role", "risk", "capability_class", "task_traits", "proof_kind", "requested_model", "requested_effort", "effective_model", "effective_effort", "owner_acceptance", "evidence_references", "observed_cost", "observed_duration_ms", "created_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "dispatch_id": { "type": "string", "minLength": 1 },
    "harness": { "type": "string", "minLength": 1 },
    "harness_version_family": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "risk": { "type": "string", "minLength": 1 },
    "capability_class": { "enum": ["economy", "balanced", "expert", "inherit"] },
    "task_traits": { "type": "array", "items": { "type": "string" } },
    "proof_kind": { "type": "string", "minLength": 1 },
    "requested_model": { "type": "string", "minLength": 1 },
    "requested_effort": { "type": "string", "minLength": 1 },
    "effective_model": { "type": "string", "minLength": 1 },
    "effective_effort": { "type": "string", "minLength": 1 },
    "owner_acceptance": { "enum": ["accepted", "rejected"] },
    "evidence_references": { "type": "array", "items": { "type": "string" } },
    "observed_cost": { "type": ["number", "null"], "minimum": 0 },
    "observed_duration_ms": { "type": ["number", "null"], "minimum": 0 },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
