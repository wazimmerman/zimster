{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wazimmerman/zimster/schemas/binding-requirements.schema.json",
  "title": "Zimster binding requirement set",
  "type": "object",
  "required": ["schema_version", "source", "requirements"],
  "properties": {
    "schema_version": {"const": 1},
    "source": {"type": "string", "minLength": 1},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z][A-Z0-9]*)*-[0-9]{3,}$"
          },
          "text": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
