{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wazimmerman/zimster/schemas/host-smoke-receipt.schema.json",
  "title": "Zimster exact-package host smoke receipt",
  "type": "object",
  "required": ["schema_version", "status", "release_channel", "policy", "public_host_ids", "all_claims_bounded", "live_verified_host_ids", "candidate_head", "candidate_tree", "dirty_tree_fingerprint", "artifact_digests", "hosts", "executed", "unavailable", "failures", "generated_at"],
  "properties": {
    "schema_version": {"const": 3},
    "status": {"enum": ["passed", "failed", "BLOCKED_BY_ENVIRONMENT"]},
    "release_channel": {"enum": ["public_beta", "stable"]},
    "policy": {
      "type": "object",
      "required": ["minimum_live_verified_hosts", "required_live_host_ids"],
      "properties": {
        "minimum_live_verified_hosts": {"type": "integer", "minimum": 1},
        "required_live_host_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "candidate_head": {"type": ["string", "null"]},
    "candidate_tree": {"type": ["string", "null"]},
    "dirty_tree_fingerprint": {"type": ["string", "null"]},
    "public_host_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "all_claims_bounded": {"type": "boolean"},
    "live_verified_host_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "artifact_digests": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "host_version", "candidate", "candidate_commit", "candidate_tree", "verification_state", "commands_or_observations", "receipt_ids", "authentication", "configuration", "model_backed_execution", "capabilities_established", "capabilities_not_established", "public_claims", "installation_available", "known_limitations", "verified_at", "expires_at"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "host_version": {"type": ["string", "null"]},
          "candidate": {"enum": ["claude", "codex", "npm", "portable"]},
          "archive": {"type": "string", "minLength": 1},
          "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "candidate_commit": {"type": ["string", "null"]},
          "candidate_tree": {"type": ["string", "null"]},
          "verification_state": {"enum": ["LIVE_VERIFIED", "INSTALLED_PACKAGE_VERIFIED", "STRUCTURALLY_VALIDATED", "BLOCKED_BY_AUTHENTICATION", "UNAVAILABLE", "UNSUPPORTED"]},
          "commands_or_observations": {"type": "array", "items": {"type": "string"}},
          "receipt_ids": {"type": "array", "items": {"type": "string"}},
          "authentication": {"type": "object", "required": ["available", "status"]},
          "configuration": {"type": "object", "required": ["available", "status"]},
          "model_backed_execution": {"type": "boolean"},
          "capabilities_established": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "capabilities_not_established": {"type": "array", "items": {"type": "string"}},
          "public_claims": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "installation_available": {"type": "boolean"},
          "known_limitations": {"type": "array", "items": {"type": "string"}},
          "verified_at": {"type": "string", "format": "date-time"},
          "expires_at": {"type": "string", "format": "date-time"},
          "exact_package_install": {"type": "boolean"},
          "fresh_session_discovery": {"type": "boolean"},
          "reason": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "executed": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "unavailable": {"type": "array", "items": {"type": "object"}},
    "failures": {"type": "array", "items": {"type": "object"}},
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
