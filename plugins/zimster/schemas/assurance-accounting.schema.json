{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wazimmerman/zimster/schemas/assurance-accounting.schema.json",
  "title": "Zimster assurance accounting reconciliation",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_head",
    "candidate_tree",
    "observed_agent_ids",
    "dispatch_agent_ids",
    "budget_agent_ids",
    "observed_review_attempt_ids",
    "recorded_review_attempt_ids",
    "recorded_review_attempt_counts",
    "budget_review_attempt_counts",
    "observed_max_depth",
    "allowed_max_depth",
    "reconciliation_complete"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "candidate_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "observed_agent_ids": {"$ref": "#/$defs/ids"},
    "dispatch_agent_ids": {"$ref": "#/$defs/ids"},
    "budget_agent_ids": {"$ref": "#/$defs/ids"},
    "observed_review_attempt_ids": {"$ref": "#/$defs/ids"},
    "recorded_review_attempt_ids": {"$ref": "#/$defs/ids"},
    "recorded_review_attempt_counts": {"$ref": "#/$defs/reviewAttemptCounts"},
    "budget_review_attempt_counts": {"$ref": "#/$defs/reviewAttemptCounts"},
    "observed_max_depth": {"type": "integer", "minimum": 0},
    "allowed_max_depth": {"type": "integer", "minimum": 0},
    "reconciliation_complete": {"type": "boolean"},
    "observed_at": {"type": ["string", "null"]},
    "source": {"type": "string"},
    "projection_corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "prior_value", "corrected_value", "reason"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "prior_value": {},
          "corrected_value": {},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "reasons": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "reviewAttemptCounts": {
      "type": "object",
      "required": ["correction_rechecks", "final_integration_reviews"],
      "properties": {
        "correction_rechecks": {"type": "integer", "minimum": 0},
        "final_integration_reviews": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
