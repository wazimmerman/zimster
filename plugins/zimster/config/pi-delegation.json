{
  "schema_version": 1,
  "protocol": "zimster.pi-delegation.v1",
  "methods": [
    "probe",
    "launch",
    "status",
    "cancel",
    "collect"
  ],
  "transport": {
    "package": "pi-subagents",
    "version": "0.42.1",
    "optional": true,
    "auto_install": false
  },
  "max_parallel_implementers": 2,
  "max_subagent_depth": 0,
  "integration_owner": "root",
  "fallback": "owner_inline"
}
